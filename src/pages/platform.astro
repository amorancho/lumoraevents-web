---
import PlatformPage from "../components/PlatformPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMessages } from "../utils/i18n";

const locale = "en";
const messages = getMessages(locale);
---

<BaseLayout
  locale={locale}
  title={messages.platformPage.meta.title}
  description={messages.platformPage.meta.description}
  page="platform"
>
  <PlatformPage locale={locale} />
</BaseLayout>
