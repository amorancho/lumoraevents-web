---
import LegalPage from "../../components/LegalPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../utils/i18n";

const locale = "es";
const messages = getMessages(locale);
---

<BaseLayout
  locale={locale}
  title={messages.privacyPage.meta.title}
  description={messages.privacyPage.meta.description}
  page="privacy"
>
  <LegalPage locale={locale} currentPage="privacy" content={messages.privacyPage} />
</BaseLayout>
