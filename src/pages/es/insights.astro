---
import InsightsPage from "../../components/InsightsPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../utils/i18n";

const locale = "es";
const messages = getMessages(locale);
---

<BaseLayout
  locale={locale}
  title={messages.insightsPage.meta.title}
  description={messages.insightsPage.meta.description}
  page="insights"
>
  <InsightsPage locale={locale} />
</BaseLayout>
