---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMessages } from "../utils/i18n";
import { getPagePath } from "../utils/routes";

const locale = "en";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${baseUrl}${getPagePath(locale, "home")}`;
const content = getMessages(locale).notFoundPage;
---

<BaseLayout
  locale={locale}
  title={content.meta.title}
  description={content.meta.description}
  noindex={true}
>
  <main class="shell flex min-h-[70vh] items-center justify-center py-20">
    <div class="panel max-w-2xl px-8 py-10 text-center sm:px-12 sm:py-14">
      <span class="eyebrow justify-center">{content.eyebrow}</span>
      <h1
        class="mt-5 text-4xl font-semibold tracking-[-0.05em] text-white sm:text-5xl"
      >
        {content.title}
      </h1>
      <p class="mt-5 text-lg leading-8 text-copy-soft">
        {content.description}
      </p>
      <a href={homeHref} class="button-primary mt-8"> {content.backHome} </a>
    </div>
  </main>
</BaseLayout>
