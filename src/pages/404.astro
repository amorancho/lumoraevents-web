---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  title="Page not found | LumoraEvents"
  description="The requested page does not exist."
>
  <main class="shell flex min-h-[70vh] items-center justify-center py-20">
    <div class="panel max-w-2xl px-8 py-10 text-center sm:px-12 sm:py-14">
      <span class="eyebrow">404</span>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl">
        This page does not exist.
      </h1>
      <p class="mt-5 text-lg leading-8 text-ink-soft">
        The route may have moved or has not been published yet.
      </p>
      <a href="/" class="button-primary mt-8"> Back to home </a>
    </div>
  </main>
</BaseLayout>
