---
import ApproachSection from "./ApproachSection.astro";
import FeaturesSection from "./FeaturesSection.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getMessages } from "../utils/i18n";
import type { Locale } from "../utils/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const content = messages.platformPage;
---

<Header
  currentLocale={locale}
  currentPage="platform"
  navigation={messages.navigation}
/>

<main class="relative isolate overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.16),transparent_68%)]"
  >
  </div>

  <section class="shell relative pb-14 pt-8 sm:pb-18 sm:pt-12">
    <div class="max-w-[50rem]">
      <span class="eyebrow reveal">{content.hero.eyebrow}</span>
      <h1
        class="editorial-display reveal mt-6 max-w-[12ch] text-5xl leading-[0.95] font-semibold tracking-[-0.06em] text-white sm:text-6xl lg:text-[5.4rem]"
        style="--reveal-delay: 80ms"
      >
        {content.hero.title}
      </h1>
      <p
        class="reveal mt-6 max-w-[38rem] text-lg leading-8 text-copy-soft sm:text-xl"
        style="--reveal-delay: 160ms"
      >
        {content.hero.description}
      </p>
    </div>
  </section>

  <section class="shell relative py-14 sm:py-18">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:gap-14">
      <div class="reveal max-w-[28rem]" style="--reveal-delay: 80ms">
        <span class="eyebrow">{content.intro.eyebrow}</span>
        <h2
          class="editorial-display mt-5 text-4xl leading-[0.98] font-semibold tracking-[-0.05em] text-white sm:text-[3.05rem]"
        >
          {content.intro.title}
        </h2>
        <p class="mt-5 text-base leading-8 text-copy-soft sm:text-lg">
          {content.intro.description}
        </p>
      </div>

      <div class="reveal border-t border-white/10" style="--reveal-delay: 140ms">
        {
          content.notes.map((item) => (
            <div class="grid gap-5 border-b border-white/10 py-6 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:gap-8 sm:py-7">
              <h3 class="text-lg font-semibold tracking-[-0.03em] text-white sm:text-xl">
                {item.title}
              </h3>
              <p class="max-w-[32rem] text-sm leading-7 text-copy-soft sm:text-base">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FeaturesSection features={messages.features} />

  <ApproachSection approach={messages.approach} />

  <section class="shell relative pb-18 pt-12 sm:pb-22">
    <div
      class="reveal relative mx-auto max-w-[48rem] rounded-[2.2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] px-6 py-10 text-center shadow-[0_20px_46px_rgba(0,0,0,0.24)] sm:px-10 sm:py-14"
      style="--reveal-delay: 120ms"
    >
      <span class="eyebrow">{content.closing.eyebrow}</span>
      <h2
        class="editorial-display mx-auto mt-6 max-w-[14ch] text-4xl leading-[1] font-semibold tracking-[-0.05em] text-white sm:text-[3.3rem]"
      >
        {content.closing.title}
      </h2>
      <p class="mx-auto mt-5 max-w-[34rem] text-base leading-8 text-copy-soft sm:text-lg">
        {content.closing.description}
      </p>
    </div>
  </section>
</main>

<Footer
  currentLocale={locale}
  navigation={messages.navigation}
  footer={messages.footer}
/>
