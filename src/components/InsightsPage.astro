---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getMessages } from "../utils/i18n";
import type { Locale } from "../utils/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const content = messages.insightsPage;
---

<Header
  currentLocale={locale}
  currentPage="insights"
  navigation={messages.navigation}
/>

<main class="relative isolate overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.16),transparent_56%)] blur-3xl"
  >
  </div>

  <section class="shell relative pb-16 pt-10 sm:pb-20 sm:pt-14">
    <div class="max-w-[46rem]">
      <span class="eyebrow reveal">{content.hero.eyebrow}</span>
      <h1
        class="editorial-display reveal mt-6 max-w-[12ch] text-5xl leading-[0.95] font-semibold tracking-[-0.06em] text-white sm:text-6xl lg:text-[5.1rem]"
        style="--reveal-delay: 80ms"
      >
        {content.hero.title}
      </h1>
      <p
        class="reveal mt-6 max-w-[35rem] text-lg leading-8 text-copy-soft sm:text-xl"
        style="--reveal-delay: 160ms"
      >
        {content.hero.description}
      </p>
    </div>
  </section>

  <section class="shell relative py-16 sm:py-22">
    <div class="reveal border-t border-white/10" style="--reveal-delay: 120ms">
      {
        content.themes.map((theme, index) => (
          <div class="grid gap-5 border-b border-white/10 py-6 sm:grid-cols-[4rem_minmax(0,18rem)_minmax(0,1fr)] sm:gap-8 sm:py-8">
            <span class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-copy-soft/50">
              0{index + 1}
            </span>
            <h2 class="text-xl font-semibold tracking-[-0.04em] text-white sm:text-2xl">
              {theme.title}
            </h2>
            <p class="max-w-[34rem] text-sm leading-7 text-copy-soft sm:text-base">
              {theme.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell relative pb-22 pt-8 sm:pb-28">
    <div
      class="pointer-events-none absolute inset-x-[14%] top-0 h-28 bg-[radial-gradient(circle,rgba(6,182,212,0.12),transparent_72%)] blur-3xl"
    >
    </div>
    <div
      class="reveal mx-auto max-w-[46rem] border-t border-white/10 pt-8 text-center"
      style="--reveal-delay: 160ms"
    >
      <span class="eyebrow">{content.closing.eyebrow}</span>
      <h2
        class="editorial-display mx-auto mt-6 max-w-[14ch] text-4xl leading-[1] font-semibold tracking-[-0.05em] text-white sm:text-[3.2rem]"
      >
        {content.closing.title}
      </h2>
      <p class="mx-auto mt-5 max-w-[34rem] text-base leading-8 text-copy-soft sm:text-lg">
        {content.closing.description}
      </p>
    </div>
  </section>
</main>

<Footer
  currentLocale={locale}
  navigation={messages.navigation}
  footer={messages.footer}
/>
