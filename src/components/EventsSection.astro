---
type EventEditorial = {
  label: string;
  title: string;
  description: string;
  styles: string[];
  note?: string;
};

interface Props {
  events: {
    editorial?: EventEditorial;
  };
}

const { events } = Astro.props;

const fallbackEditorial: EventEditorial = {
  label: "Types of events",
  title: "Not every competition works the same way.",
  description:
    "LumoraEvents adapts naturally to competitions with different styles, structures, and judging dynamics.",
  styles: [
    "URBAN",
    "BELLYDANCE",
    "MODERN",
    "CONTEMPORARY",
    "FUSION",
    "K-POP",
    "CLASSICAL BALLET",
    "OPEN",
    "ANY STYLE",
  ],
  note:
    "The same structure can also adapt to canine events, gastronomy, beauty, vocal competitions, and other formats built around judging and scoring dynamics.",
};

const editorial: EventEditorial = {
  ...fallbackEditorial,
  ...(events.editorial ?? {}),
  styles:
    events.editorial?.styles && events.editorial.styles.length > 0
      ? events.editorial.styles
      : fallbackEditorial.styles,
};

const isExpandedStyle = (style: string) => {
  const normalized = style.trim().toUpperCase();
  return normalized === "ANY STYLE" || normalized === "CUALQUIER ESTILO";
};
---

<section class="shell pb-12 pt-4 sm:pb-14 sm:pt-6 lg:pb-16">
  <div class="border-y border-white/8 py-7 sm:py-8 lg:py-9">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-end lg:gap-10">
      <div class="max-w-[34rem]">
        <span class="eyebrow reveal">{editorial.label}</span>

        <p
          class="reveal mt-4 max-w-[21ch] text-2xl font-semibold tracking-[-0.05em] text-white sm:text-[1.85rem] sm:leading-[1.12]"
          style="--reveal-delay: 80ms"
        >
          {editorial.title}
        </p>

        <p
          class="reveal mt-3 max-w-[34rem] text-sm leading-7 text-copy-soft sm:text-base"
          style="--reveal-delay: 140ms"
        >
          {editorial.description}
        </p>
      </div>

      <div
        class="reveal max-w-[34rem] sm:max-w-[42rem] lg:ml-auto lg:max-w-[39rem]"
        style="--reveal-delay: 200ms"
      >
        <ul
          class="flex flex-wrap items-center gap-2.5 lg:justify-end"
          aria-label={editorial.label}
        >
          {
            editorial.styles.map((style) => (
              <li>
                <span
                  class:list={[
                    "inline-flex items-center rounded-full px-3 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.22em]",
                    isExpandedStyle(style)
                      ? "gap-2 border border-cyan-300/30 bg-[linear-gradient(135deg,rgba(34,211,238,0.18),rgba(255,255,255,0.05))] pr-3.5 text-white shadow-[0_10px_30px_rgba(6,182,212,0.16)] ring-1 ring-cyan-200/10"
                      : "border border-white/10 bg-white/[0.03] text-copy-soft/86",
                  ]}
                >
                  {
                    isExpandedStyle(style) && (
                      <span
                        aria-hidden="true"
                        class="inline-block h-2 w-2 rounded-full bg-cyan-200 shadow-[0_0_0_4px_rgba(34,211,238,0.14)]"
                      ></span>
                    )
                  }
                  {style}
                </span>
              </li>
            ))
          }
        </ul>

        {
          editorial.note && (
            <p class="mt-4 max-w-[31rem] text-[0.95rem] leading-6 text-copy-soft/72 lg:ml-auto lg:text-right">
              {editorial.note}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
