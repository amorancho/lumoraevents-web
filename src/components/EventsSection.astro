---
type EventEditorial = {
  label: string;
  title: string;
  description: string;
  styles: string[];
  secondaryLabel?: string;
  secondaryStyles?: string[];
};

interface Props {
  events: {
    editorial?: EventEditorial;
  };
}

const { events } = Astro.props;

const fallbackEditorial: EventEditorial = {
  label: "Types of events",
  title: "Not every competition works the same way.",
  description:
    "LumoraEvents adapts naturally to competitions with different styles, structures, and judging dynamics.",
  styles: [
    "URBAN",
    "BELLYDANCE",
    "MODERN",
    "CONTEMPORARY",
    "FUSION",
    "K-POP",
    "CLASSICAL BALLET",
    "OPEN",
    "ANY STYLE",
  ],
  secondaryLabel: "Beyond dance",
  secondaryStyles: [
    "GASTRONOMIC",
    "BEAUTY",
    "CANINE",
    "VOCAL / SINGING",
    "AND MUCH MORE",
  ],
};

const editorial: EventEditorial = {
  ...fallbackEditorial,
  ...(events.editorial ?? {}),
  styles:
    events.editorial?.styles && events.editorial.styles.length > 0
      ? events.editorial.styles
      : fallbackEditorial.styles,
  secondaryStyles:
    events.editorial?.secondaryStyles && events.editorial.secondaryStyles.length > 0
      ? events.editorial.secondaryStyles
      : fallbackEditorial.secondaryStyles,
};

const isExpandedStyle = (style: string) => {
  const normalized = style.trim().toUpperCase();
  return normalized === "ANY STYLE" || normalized === "CUALQUIER ESTILO";
};
---

<section class="shell pb-12 pt-4 sm:pb-14 sm:pt-6 lg:pb-16">
  <div class="border-y border-white/8 py-7 sm:py-8 lg:py-9">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:items-center lg:gap-10">
      <div class="max-w-[34rem]">
        <span class="eyebrow reveal">{editorial.label}</span>

        <p
          class="reveal mt-4 max-w-[21ch] text-2xl font-semibold tracking-[-0.05em] text-white sm:text-[1.85rem] sm:leading-[1.12]"
          style="--reveal-delay: 80ms"
        >
          {editorial.title}
        </p>

        <p
          class="reveal mt-3 max-w-[34rem] text-sm leading-7 text-copy-soft sm:text-base"
          style="--reveal-delay: 140ms"
        >
          {editorial.description}
        </p>
      </div>

      <div
        class="reveal max-w-[34rem] sm:max-w-[44rem] lg:ml-auto lg:flex lg:w-full lg:max-w-[42rem] lg:flex-col lg:justify-center"
        style="--reveal-delay: 200ms"
      >
        <ul
          class="flex flex-wrap items-center gap-2 lg:justify-end"
          aria-label={editorial.label}
        >
          {
            editorial.styles.map((style) => (
              <li>
                <span
                  class:list={[
                    "inline-flex items-center rounded-full px-2.5 py-1.5 text-[0.64rem] font-semibold uppercase tracking-[0.18em] sm:px-3 sm:text-[0.66rem]",
                    isExpandedStyle(style)
                      ? "gap-2 border border-cyan-300/28 bg-[linear-gradient(135deg,rgba(34,211,238,0.16),rgba(255,255,255,0.04))] pr-3 text-white shadow-[0_8px_24px_rgba(6,182,212,0.14)] ring-1 ring-cyan-200/8"
                      : "border border-white/10 bg-white/[0.03] text-copy-soft/86",
                  ]}
                >
                  {
                    isExpandedStyle(style) && (
                      <span
                        aria-hidden="true"
                        class="inline-block h-2 w-2 rounded-full bg-cyan-200 shadow-[0_0_0_4px_rgba(34,211,238,0.14)]"
                      ></span>
                    )
                  }
                  {style}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-3.5 lg:ml-auto lg:max-w-[35rem]">
          <p class="text-[0.58rem] font-semibold uppercase tracking-[0.22em] text-copy-soft/52 lg:text-right">
            {editorial.secondaryLabel}
          </p>

          <ul
            class="mt-2 flex flex-wrap items-center gap-1.5 lg:justify-end"
            aria-label={editorial.secondaryLabel}
          >
            {
              (editorial.secondaryStyles ?? []).map((style) => (
                <li>
                  <span class="inline-flex items-center rounded-full border border-white/6 bg-white/[0.018] px-2.5 py-1 text-[0.56rem] font-medium uppercase tracking-[0.16em] text-copy-soft/58 sm:px-3">
                    {style}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
