          </div>
        </div>

        <div
          class="mt-4 max-w-xs rounded-[1.4rem] border border-white/10 bg-black/72 px-5 py-4 text-sm leading-7 text-copy-soft shadow-[0_14px_34px_rgba(0,0,0,0.22)] sm:absolute sm:-right-2 sm:bottom-6 sm:mt-0"
