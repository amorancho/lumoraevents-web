                publicLiveResultsMobileHasImage ? (
                  <img
                    src={publicLiveResultsMobileSrc}
                    alt="LumoraEvents public live results mobile view"
                    class="h-auto w-full rounded-[0.9rem] border border-white/8 object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="grid min-h-[12rem] place-items-center rounded-[0.9rem] border border-dashed border-white/12 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_48%),linear-gradient(180deg,rgba(12,12,14,0.96),rgba(8,8,10,0.98))] px-4 py-6 text-center sm:min-h-[16rem]">
                    <div>
                      <p class="text-sm font-semibold text-white">
                        Mobile results
                      </p>
                      <p class="mt-2 text-xs leading-5 text-copy-soft">
                        Placements and scores ready to check at a glance.
                      </p>
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        </div>

        <div
          class="mt-4 flex max-w-sm items-start gap-3 rounded-[1.4rem] border border-white/10 bg-black/72 px-5 py-4 text-sm leading-7 text-copy-soft shadow-[0_14px_34px_rgba(0,0,0,0.22)] sm:absolute sm:left-[12%] sm:bottom-6 sm:mt-0 lg:left-[18%]"
        >
          <span class="mt-2 size-2 shrink-0 rounded-full bg-accent-cyan"></span>
          <p>
            Participants and audiences stay informed without chasing updates.
          </p>
        </div>
      </div>
    </article>
  </div>
</section>
