            </div>
          </div>

          <div
            class="relative mt-4 ml-auto w-[52%] overflow-hidden rounded-[1.7rem] border border-white/10 bg-black/72 p-3 shadow-[0_14px_34px_rgba(0,0,0,0.22)] sm:absolute sm:right-[6%] sm:top-28 sm:mt-0 sm:w-[28%]"
          >
            <div
              class="overflow-hidden rounded-[1.35rem] border border-white/10 bg-black/44 p-3"
            >
              {
                judges.hasImage ? (
                  <img
                    src={judges.imageSrc}
                    alt={judges.imageAlt}
                    class="h-auto w-full rounded-[0.9rem] border border-white/8 object-cover"
