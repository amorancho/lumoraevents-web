          <div
            class="relative overflow-hidden rounded-[1.7rem] border border-white/10 bg-black/72 p-3 shadow-[0_14px_34px_rgba(0,0,0,0.22)] sm:absolute sm:right-[2%] sm:bottom-16 sm:mt-0 sm:w-[22%] lg:right-[4%] lg:w-[21%]"
