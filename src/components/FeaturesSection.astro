            <div class="mb-3 flex items-center gap-2 px-1">
              <span class="size-1.5 rounded-full bg-white/75"></span>
              <span class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-copy-soft">
                Results
              </span>
            </div>

            <div
              class="overflow-hidden rounded-[1.35rem] border border-white/10 bg-black/44 p-3"
            >
