---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

type PlatformSectionId =
  | "registrations"
  | "configuration"
  | "judges"
  | "live-tracking"
  | "public-live";

type PlatformSectionExtra = {
  title: string;
  description: string;
};

type PlatformSection = {
  id: string;
  title: string;
  benefit?: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  previewLabel?: string;
  previewItems?: string[];
  extrasLabel?: string;
  extras?: PlatformSectionExtra[];
  previewFootnote?: string;
  new?: string;
};

type UpcomingFeature = {
  badge: string;
  title: string;
  description: string;
  note: string;
  previewEyebrow: string;
  previewItems: string[];
};

interface Props {
  features: {
    eyebrow: string;
    title: string;
    description: string;
    labels?: {
      new?: string;
    };
    sections: PlatformSection[];
    upcoming?: UpcomingFeature;
  };
}

const { features } = Astro.props;

const publicRoot = new URL("../../public/", import.meta.url);
const hasAsset = (src: string) =>
  existsSync(fileURLToPath(new URL(src.replace(/^\//, ""), publicRoot)));

const sectionOrder: PlatformSectionId[] = [
  "registrations",
  "configuration",
  "judges",
  "live-tracking",
  "public-live",
];

const fallbackSections: PlatformSection[] = [
  {
    id: "registrations",
    title: "Registrations",
    benefit: "Bring entries, schools, categories, and music into one intake flow.",
    description:
      "Collect competition data in one place instead of rebuilding the event from spreadsheets, emails, and separate forms.",
    imageSrc: "/images/platform/registrations.webp",
    imageAlt: "LumoraEvents registrations flow",
    previewLabel: "Registration flow",
    previewItems: ["Schools", "Participants", "Categories", "Music"],
    previewFootnote: "Everything arrives structured before competition day.",
  },
  {
    id: "configuration",
    title: "Configuration",
    benefit: "Shape schedules, judges, and criteria before the day gets busy.",
    description:
      "Set the operational rules once, keep the structure readable, and prepare the event without jumping across disconnected tools.",
    imageSrc: "/images/platform/configuration.webp",
    imageAlt: "LumoraEvents event configuration and schedule setup",
    previewLabel: "Event setup",
    previewItems: ["Schedules", "Judge panels", "Criteria", "Rounds"],
    extrasLabel: "Cross-cutting capabilities",
    extras: [
      {
        title: "Plan B",
        description:
          "Export the full event to PDF so the team can continue if connectivity drops on event day.",
      },
      {
        title: "Multilingual",
        description:
          "Available in Spanish, English, French, Italian, and Portuguese, with room for more when needed.",
      },
      {
        title: "Imports",
        description:
          "Bring in participants, categories, and event structure from WOP, Excel, or spreadsheets.",
      },
      {
        title: "Exports",
        description:
          "Export results, schedules, and platform data to PDF or Excel whenever you need them.",
      },
    ],
    previewFootnote: "A flexible setup layer for the moving parts.",
  },
  {
    id: "judges",
    title: "Judges experience",
    benefit: "Keep scoring clean, fast, and easy to follow on any device.",
    description:
      "Judges work from a focused interface that reduces friction under pressure and keeps results flowing back into the event in real time.",
    imageSrc: "/images/platform/judges.webp",
    imageAlt: "LumoraEvents judges scoring interface",
    previewLabel: "Scoring flow",
    previewItems: ["Tablet ready", "Mobile ready", "Fast input", "Live sync"],
    previewFootnote: "Built for live scoring without extra noise.",
  },
  {
    id: "live-tracking",
    title: "Live tracking",
    benefit: "See what is live, what is next, and where attention is needed.",
    description:
      "Give organizers one calmer operational view during the event, with the current stage of the competition always within reach.",
    imageSrc: "/images/platform/live-tracking.webp",
    imageAlt: "LumoraEvents live tracking screen",
    previewLabel: "Control board",
    previewItems: ["Now live", "Up next", "Delays", "Attention points"],
    previewFootnote: "A clearer operational pulse during the day.",
  },
  {
    id: "public-live",
    title: "Public live experience",
    benefit: "Share schedules, performances, and results without manual updates.",
    description:
      "Participants and audiences follow the event through a public layer that keeps them informed without pulling the team away from operations.",
    imageSrc: "/images/platform/public-live.webp",
    imageAlt: "LumoraEvents public live experience",
    previewLabel: "Public live",
    previewItems: ["Schedules", "Performance order", "Results", "Live status"],
    previewFootnote: "A public view that stays aligned with the event.",
  },
];

const fallbackUpcoming: UpcomingFeature = {
  badge: "Coming soon",
  title: "Workshop & Masterclasses",
  description:
    "A lighter extension for workshops, masterclasses, and special sessions inside the same product ecosystem.",
  note: "Designed as a teaser for what comes next, not as a separate product story.",
  previewEyebrow: "Future layer",
  previewItems: ["Workshops", "Masterclasses", "Special sessions"],
};

const fallbackById = new Map(
  fallbackSections.map((section) => [section.id as PlatformSectionId, section]),
);
const providedById = new Map(
  features.sections.map((section) => [
    section.id as PlatformSectionId,
    section,
  ]),
);

const sections = sectionOrder.map((id) => {
  const fallback = fallbackById.get(id) ?? fallbackSections[0];
  const section = providedById.get(id);
  const imageSrc = section?.imageSrc ?? fallback.imageSrc;

  return {
    ...fallback,
    ...section,
    id,
    imageSrc,
    previewItems:
      section?.previewItems && section.previewItems.length > 0
        ? section.previewItems
        : fallback.previewItems,
    extras:
      section?.extras && section.extras.length > 0 ? section.extras : fallback.extras,
    hasImage: hasAsset(imageSrc),
  };
});

const upcoming = {
  ...fallbackUpcoming,
  ...features.upcoming,
};
const newBadgeLabel = features.labels?.new ?? "New";

const toneById: Record<
  PlatformSectionId,
  {
    dotClass: string;
    previewGlow: string;
  }
> = {
  registrations: {
    dotClass: "bg-accent-cyan/80",
    previewGlow:
      "bg-[radial-gradient(circle_at_top,rgba(6,182,212,0.12),transparent_58%)]",
  },
  configuration: {
    dotClass: "bg-accent/78",
    previewGlow:
      "bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.12),transparent_58%)]",
  },
  judges: {
    dotClass: "bg-accent-cyan/80",
    previewGlow:
      "bg-[radial-gradient(circle_at_top,rgba(6,182,212,0.12),transparent_58%)]",
  },
  "live-tracking": {
    dotClass: "bg-accent/78",
    previewGlow:
      "bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.12),transparent_58%)]",
  },
  "public-live": {
    dotClass: "bg-accent-cyan/80",
    previewGlow:
      "bg-[radial-gradient(circle_at_top,rgba(6,182,212,0.12),transparent_58%),radial-gradient(circle_at_78%_0%,rgba(124,58,237,0.08),transparent_34%)]",
  },
};
---

<section id="features" class="shell relative pb-14 pt-10 sm:pb-16 sm:pt-12 lg:pb-20 lg:pt-14">
  <div class="section-intro section-intro-centered relative z-10 max-w-[54rem]">
    <span class="eyebrow reveal justify-center">{features.eyebrow}</span>
    <h2
      class="section-title reveal"
      style="--reveal-delay: 80ms"
    >
      {features.title}
    </h2>
    <p
      class="section-description reveal mx-auto max-w-[41rem]"
      style="--reveal-delay: 160ms"
    >
      {features.description}
    </p>
  </div>

  <div class="relative z-10 mx-auto mt-10 max-w-[72rem] space-y-4 sm:mt-12 sm:space-y-5">
    {
      sections.map((section, index) => {
        const tone = toneById[section.id as PlatformSectionId] ?? toneById.registrations;
        const previewItems = section.previewItems ?? [];
        const extras = section.extras ?? [];

        return (
          <article
            class="reveal surface-card relative overflow-hidden p-5 sm:p-6"
            style={`--reveal-delay: ${220 + index * 60}ms`}
          >
            <div
              class:list={[
                "pointer-events-none absolute inset-0 opacity-90",
                tone.previewGlow,
              ]}
            ></div>

            <div
              class:list={[
                "relative z-10 grid h-full gap-5 xl:items-center",
                "xl:grid-cols-[minmax(0,1.15fr)_minmax(16rem,0.85fr)]",
              ]}
            >
              <div class="max-w-[34rem]">
                <div class="flex items-center gap-3">
                  <span
                    class:list={[
                      "inline-flex min-w-[2.4rem] items-center justify-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-copy-soft",
                    ]}
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-copy-soft/84">
                    {section.title}
                  </span>
                </div>

                <h3 class="mt-4 max-w-[18ch] text-[1.8rem] font-semibold tracking-[-0.05em] text-white sm:text-[1.95rem] sm:leading-[1.04]">
                  {section.benefit}
                </h3>

                <p class="mt-3 max-w-[33rem] text-sm leading-[1.625rem] text-copy-soft sm:text-base sm:leading-7">
                  {section.description}
                </p>
              </div>

              <div class="relative z-10">
                <div class="product-mini-frame bg-black/52 p-2.5 sm:p-3">
                  <div class="flex items-center justify-between gap-3">
                    <span class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-copy-soft">
                      {section.previewLabel}
                    </span>
                    <span class:list={["size-2 rounded-full", tone.dotClass]}></span>
                  </div>

                  {
                    section.hasImage ? (
                      <div class="mt-2 overflow-hidden rounded-[1.15rem] border border-white/10 bg-black/36">
                        <img
                          src={section.imageSrc}
                          alt={section.imageAlt}
                          class="aspect-[16/9] w-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : (
                      <div class="mt-2 rounded-[1.15rem] border border-white/10 bg-black/36 p-3">
                        <div class="space-y-1.5">
                          {previewItems.map((item) => (
                            <div class="flex items-center justify-between gap-3 rounded-[1rem] border border-white/8 bg-white/[0.03] px-3 py-1.5">
                              <div class="flex items-center gap-2.5">
                                <span
                                  class:list={[
                                    "size-1.5 rounded-full",
                                    tone.dotClass,
                                  ]}
                                ></span>
                                <span class="text-xs text-copy-soft">{item}</span>
                              </div>
                              <span class="h-2 w-8 rounded-full bg-white/10"></span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )
                  }

                  {
                    section.hasImage && previewItems.length > 0 ? (
                      <div class="mt-2 flex flex-wrap gap-2">
                        {previewItems.map((item) => (
                          <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-1 text-[0.68rem] text-copy-soft">
                            {item}
                          </span>
                        ))}
                      </div>
                    ) : null
                  }

                  {
                    section.new ? (
                      <div class="mt-2.5 rounded-[1rem] border border-amber-200/30 bg-[linear-gradient(135deg,rgba(251,191,36,0.22),rgba(251,191,36,0.08)_42%,rgba(255,255,255,0.04))] px-3 py-2.5 shadow-[0_10px_24px_rgba(245,158,11,0.12)]">
                        <div class="flex items-center gap-2">
                          <span class="inline-flex items-center rounded-full border border-amber-100/30 bg-amber-300/15 px-2 py-0.5 text-[0.58rem] font-semibold uppercase tracking-[0.2em] text-amber-50">
                            {newBadgeLabel}
                          </span>
                          <span class="h-px flex-1 bg-gradient-to-r from-amber-100/30 to-transparent"></span>
                        </div>

                        <p class="mt-2 text-sm font-semibold leading-5 text-white">
                          {section.new}
                        </p>
                      </div>
                    ) : null
                  }
                </div>
              </div>
            </div>

            {
              extras.length > 0 ? (
                <div class="relative z-10 mt-5 rounded-[1.2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] p-4 sm:p-4.5">
                  <div class="flex items-center gap-3">
                    <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[0.58rem] font-semibold uppercase tracking-[0.2em] text-copy-soft">
                      {section.extrasLabel}
                    </span>
                    <span class="h-px flex-1 bg-gradient-to-r from-white/16 to-transparent"></span>
                  </div>

                  <div class="mt-3 grid gap-2.5 sm:grid-cols-2 xl:grid-cols-4">
                    {extras.map((item) => (
                      <div class="rounded-[1rem] border border-white/8 bg-black/26 px-3 py-3">
                        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-white/90">
                          {item.title}
                        </p>
                        <p class="mt-1.5 text-[0.74rem] leading-5 text-copy-soft">
                          {item.description}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              ) : null
            }
          </article>
        );
      })
    }
  </div>

  <div class="relative z-10 mt-10 pt-8 sm:mt-14 sm:pt-10">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/16 to-transparent"></div>

    <article
      class="reveal relative overflow-hidden rounded-[2rem] border border-white/12 bg-[linear-gradient(135deg,rgba(8,47,73,0.94),rgba(10,14,24,0.96)_48%,rgba(88,28,135,0.35))] p-6 shadow-[0_28px_80px_rgba(3,7,18,0.32)] sm:p-7"
      style="--reveal-delay: 560ms"
    >
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_14%_18%,rgba(34,211,238,0.16),transparent_26%),radial-gradient(circle_at_82%_18%,rgba(168,85,247,0.16),transparent_28%),linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.01))]"></div>
      <div class="pointer-events-none absolute -right-14 top-6 h-32 w-32 rounded-full border border-white/10 bg-white/[0.03] blur-2xl"></div>

      <div class="relative z-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)] lg:items-center">
        <div class="max-w-[40rem]">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-cyan-200/18 bg-cyan-300/10 px-3 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-cyan-50">
              <span class="size-1.5 rounded-full bg-cyan-300"></span>
              {upcoming.badge}
            </span>
            <span class="h-px flex-1 bg-gradient-to-r from-cyan-200/24 to-transparent"></span>
          </div>

          <h3 class="mt-5 max-w-[16ch] text-[2rem] font-semibold tracking-[-0.05em] text-white sm:text-[2.2rem] sm:leading-[1.02]">
            {upcoming.title}
          </h3>

          <p class="mt-3 max-w-[34rem] text-base leading-7 text-copy-soft sm:text-lg">
            {upcoming.description}
          </p>

          <p class="mt-3 max-w-[32rem] text-sm leading-[1.625rem] text-copy-soft/86 sm:leading-7">
            {upcoming.note}
          </p>
        </div>

        <aside class="rounded-[1.55rem] border border-white/12 bg-black/22 p-4 backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <span class="rounded-full border border-white/10 bg-white/[0.05] px-3 py-1 text-[0.58rem] font-semibold uppercase tracking-[0.22em] text-copy-soft">
              {upcoming.previewEyebrow}
            </span>
            <span class="h-px flex-1 bg-gradient-to-r from-white/20 to-transparent"></span>
          </div>

          <div class="mt-4 space-y-2.5">
            {upcoming.previewItems.map((item, index) => (
              <div class="flex items-center gap-3 rounded-[1rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.07),rgba(255,255,255,0.03))] px-3 py-2.5 text-sm text-copy-soft">
                <span
                  class:list={[
                    "size-2 rounded-full",
                    index === 1 ? "bg-white/72" : index === 2 ? "bg-accent/80" : "bg-accent-cyan/85",
                  ]}
                ></span>
                <span class="font-medium text-white/92">{item}</span>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </article>
  </div>
</section>
