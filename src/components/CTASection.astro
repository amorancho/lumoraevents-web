---
interface Props {
  cta: {
    eyebrow: string;
    title: string;
    description: string;
    primaryCta: string;
  };
  primaryHref: string;
}

const { cta, primaryHref } = Astro.props;
---

<section id="cta" class="shell relative pb-20 pt-10 sm:pb-28 sm:pt-14">
  <div
    class="pointer-events-none absolute inset-x-0 top-10 h-56 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.14),transparent_68%)] blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-28 h-28 w-28 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(6,182,212,0.08),transparent_72%)] blur-3xl"
  >
  </div>

  <div class="relative z-10 border-y border-white/8 py-14 sm:py-18 lg:py-22">
    <div class="mx-auto max-w-[46rem] text-center">
      <span class="eyebrow reveal justify-center">{cta.eyebrow}</span>
      <h2
        class="reveal mt-6 text-4xl font-semibold tracking-[-0.06em] text-balance text-white sm:text-5xl lg:text-[4.2rem] lg:leading-[0.97]"
        style="--reveal-delay: 80ms"
      >
        {cta.title}
      </h2>
      <p
        class="reveal mx-auto mt-5 max-w-[34rem] text-base leading-8 text-copy-soft sm:text-lg"
        style="--reveal-delay: 160ms"
      >
        {cta.description}
      </p>

      <div
        class="reveal mt-9 flex justify-center"
        style="--reveal-delay: 240ms"
      >
        <a href={primaryHref} class="button-primary px-6 py-3.5">
          {cta.primaryCta}
        </a>
      </div>
    </div>
  </div>
</section>
