---
interface Props {
  cta: {
    title: string;
    description: string;
    primaryCta: string;
    secondaryCta: string;
  };
  primaryHref: string;
  secondaryHref: string;
}

const { cta, primaryHref, secondaryHref } = Astro.props;
---

<section id="cta" class="shell pb-16 pt-4 sm:pb-24">
  <div class="panel px-8 py-10 text-center sm:px-12 sm:py-14">
    <span class="eyebrow">Ready to grow</span>
    <h2
      class="mx-auto mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
    >
      {cta.title}
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-ink-soft">
      {cta.description}
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={primaryHref} class="button-primary">
        {cta.primaryCta}
      </a>
      <a href={secondaryHref} class="button-secondary">
        {cta.secondaryCta}
      </a>
    </div>
  </div>
</section>
