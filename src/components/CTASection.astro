---
interface Props {
  cta: {
    eyebrow: string;
    title: string;
    description: string;
    primaryCta: string;
    secondaryCta: string;
  };
  primaryHref: string;
  secondaryHref: string;
}

const { cta, primaryHref, secondaryHref } = Astro.props;
---

<section id="cta" class="shell pb-16 pt-4 sm:pb-24">
  <div
    class="panel reveal grid gap-8 px-8 py-10 sm:px-10 sm:py-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end"
  >
    <div class="max-w-3xl">
      <span class="eyebrow">{cta.eyebrow}</span>
      <h2
        class="mt-5 max-w-3xl text-4xl font-semibold tracking-[-0.05em] text-balance text-white sm:text-5xl"
      >
        {cta.title}
      </h2>
      <p class="section-copy mt-5 max-w-2xl">
        {cta.description}
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={primaryHref} class="button-primary">
        {cta.primaryCta}
      </a>
      <a href={secondaryHref} class="button-secondary">
        {cta.secondaryCta}
      </a>
    </div>
  </div>
</section>
