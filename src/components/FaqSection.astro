---
type FaqItem = {
  question: string;
  answer: string;
};

interface Props {
  faq: {
    eyebrow: string;
    title: string;
    description: string;
    items: FaqItem[];
  };
}

const { faq } = Astro.props;

const fallbackItems: FaqItem[] = [
  {
    question: "Do we need technical knowledge to run it?",
    answer:
      "No. LumoraEvents is designed for event teams, with a setup that stays clear and support that stays close when needed.",
  },
  {
    question: "How do judges submit scores during the event?",
    answer:
      "Judges score from a clean interface on tablet or phone, so input stays fast and readable under live pressure.",
  },
  {
    question: "Can it adapt to our own competition rules?",
    answer:
      "Yes. Scoring logic, judging flow, categories, and timings can be adjusted to fit how your event already works.",
  },
  {
    question: "Does it work on phones and tablets?",
    answer:
      "Yes. The platform is built to work smoothly across modern browsers on mobile, tablet, and desktop.",
  },
  {
    question: "Do you provide support during the competition day?",
    answer:
      "Yes. We stay available before, during, and after the event so operational questions do not turn into stress.",
  },
  {
    question: "Can the audience follow the competition live?",
    answer:
      "Yes. Schedules, participants, and results can be shared through a live public experience with clear visibility.",
  },
  {
    question: "Do we need to install anything?",
    answer:
      "No installation is required. LumoraEvents runs in the browser, which keeps rollout simple for teams and judges.",
  },
];

const items = faq.items.length ? faq.items : fallbackItems;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="shell relative py-16 sm:py-20 lg:py-24">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <div
    class="relative z-10 grid gap-10 border-y border-white/8 py-10 sm:gap-12 sm:py-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14 lg:py-14"
  >
    <div class="max-w-[31rem]">
      <span class="eyebrow reveal">{faq.eyebrow}</span>
      <h2
        class="reveal mt-5 max-w-[12ch] text-4xl font-semibold tracking-[-0.06em] text-balance text-white sm:text-5xl lg:text-[3.8rem] lg:leading-[0.98]"
        style="--reveal-delay: 80ms"
      >
        {faq.title}
      </h2>
      <p
        class="reveal mt-5 max-w-[30rem] text-lg leading-8 text-copy-soft sm:text-xl"
        style="--reveal-delay: 160ms"
      >
        {faq.description}
      </p>
    </div>

    <div class="reveal relative" style="--reveal-delay: 220ms">
      <div
        class="pointer-events-none absolute inset-y-0 left-0 hidden w-px bg-white/8 lg:block"
      >
      </div>

      <div class="lg:pl-10">
        {
          items.map((item, index) => (
            <details
              name="lumora-faq"
              class:list={[
                "faq-item group rounded-[1.7rem] border border-transparent bg-transparent px-0 py-0 transition-colors duration-300",
                index !== 0 && "mt-3",
              ]}
            >
              <summary class="faq-trigger rounded-[1.7rem] border border-white/8 bg-white/[0.02] px-5 py-4 sm:px-6 sm:py-5">
                <span class="pr-4 text-left text-base font-semibold tracking-[-0.03em] text-white sm:text-[1.05rem]">
                  {item.question}
                </span>
                <span
                  class="faq-icon ml-4 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-copy-soft"
                >
                  <span class="faq-icon-line faq-icon-line-horizontal"></span>
                  <span class="faq-icon-line faq-icon-line-vertical"></span>
                </span>
              </summary>

              <div class="faq-answer-wrap">
                <div class="faq-answer-inner px-5 pb-5 pt-1 sm:px-6 sm:pb-6">
                  <p class="max-w-[38rem] text-sm leading-7 text-copy-soft sm:text-base">
                    {item.answer}
                  </p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
