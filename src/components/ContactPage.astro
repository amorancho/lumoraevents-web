---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { getMessages } from "../utils/i18n";
import type { Locale } from "../utils/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const content = messages.contactPage;
const copy =
  locale === "es"
    ? {
        eyebrow: "Contacto",
        title: "Cuéntanos cómo es tu evento.",
        description:
          "Si estás preparando una competición y quieres ver si LumoraEvents encaja con la forma en la que trabaja tu equipo, podemos empezar en ese punto.",
        methodNotes: [
          "La forma más directa de empezar una conversación.",
          "Una forma más tranquila e informal de mantener el contacto.",
          "Para equipos que ya tienen acceso y quieren entrar directamente.",
        ],
      }
    : {
        eyebrow: "Contact",
        title: "Tell us about your event.",
        description:
          "If you are planning a competition and want to see whether LumoraEvents fits the way your team works, we can start from there.",
        methodNotes: [
          "The most direct way to start a conversation.",
          "A quieter, more informal way to stay in touch.",
          "For teams who already have access and want to enter directly.",
        ],
      };
const methods = content.methods.map((method, index) => ({
  ...method,
  note: copy.methodNotes[index] ?? method.note,
}));
---

<Header currentLocale={locale} currentPage="contact" navigation={messages.navigation} />

<main class="relative isolate overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[12rem] bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.08),transparent_58%)] blur-3xl"
  >
  </div>

  <section class="shell relative pb-16 pt-6 sm:pb-18 sm:pt-8">
    <div class="mx-auto max-w-[40rem]">
      <div class="reveal mx-auto max-w-[30rem] text-center" style="--reveal-delay: 80ms">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1
          class="mt-4 text-[2rem] leading-[1.06] font-semibold tracking-[-0.05em] text-white sm:text-[2.45rem]"
        >
          {copy.title}
        </h1>
        <p class="mt-4 text-base leading-8 text-copy-soft sm:text-lg">
          {copy.description}
        </p>
      </div>

      <div
        class="reveal mt-8 rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 shadow-[0_16px_40px_rgba(0,0,0,0.18)] sm:mt-10 sm:p-5"
        style="--reveal-delay: 140ms"
      >
        <div class="border-t border-white/10">
          {
            methods.map((method) => (
              <a
                href={method.href}
                target={method.href.startsWith("http") ? "_blank" : undefined}
                rel={method.href.startsWith("http") ? "noreferrer" : undefined}
                class="grid gap-3 border-b border-white/10 py-5 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6 sm:py-6"
              >
                <span class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-copy-soft/56">
                  {method.label}
                </span>
                <div>
                  <p class="text-lg font-semibold tracking-[-0.04em] text-white sm:text-[1.35rem]">
                    {method.value}
                  </p>
                  <p class="mt-2 max-w-[28rem] text-sm leading-7 text-copy-soft sm:text-base">
                    {method.note}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</main>

<Footer
  currentLocale={locale}
  navigation={messages.navigation}
  footer={messages.footer}
/>
