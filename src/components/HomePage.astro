---
import ApproachSection from "./ApproachSection.astro";
import CTASection from "./CTASection.astro";
import EventsSection from "./EventsSection.astro";
import FaqSection from "./FaqSection.astro";
import FeaturesSection from "./FeaturesSection.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import HeroSection from "./HeroSection.astro";
import { getMessages } from "../utils/i18n";
import { siteConfig, type Locale } from "../utils/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const contactHref = `mailto:${siteConfig.email}`;
const appHref = siteConfig.appUrl;
---

<Header
  currentLocale={locale}
  navigation={messages.navigation}
  primaryHref={contactHref}
  appHref={appHref}
/>

<main class="relative isolate">
  <HeroSection
    hero={messages.hero}
    primaryHref={contactHref}
    secondaryHref={appHref}
  />

  <EventsSection events={messages.events} />

  <ApproachSection approach={messages.approach} />

  <FeaturesSection features={messages.features} />

  <FaqSection faq={messages.faq} />

  <CTASection cta={messages.cta} primaryHref={contactHref} />
</main>

<Footer
  currentLocale={locale}
  navigation={messages.navigation}
  footer={messages.footer}
/>
