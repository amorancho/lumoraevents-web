---
import ApproachSection from "./ApproachSection.astro";
import CTASection from "./CTASection.astro";
import EventLogosSection from "./EventLogosSection.astro";
import EventsSection from "./EventsSection.astro";
import FaqSection from "./FaqSection.astro";
import FeaturesSection from "./FeaturesSection.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import HeroSection from "./HeroSection.astro";
import { getMessages } from "../utils/i18n";
import { getPagePath } from "../utils/routes";
import { type Locale } from "../utils/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const contactHref = `${baseUrl}${getPagePath(locale, "contact")}`;
---

<Header currentLocale={locale} currentPage="home" navigation={messages.navigation} />

<main class="relative isolate">
  <HeroSection hero={messages.hero} />

  <EventsSection events={messages.events} />

  <FeaturesSection features={messages.features} />

  <ApproachSection approach={messages.approach} />

  <EventLogosSection events={messages.events} />

  <CTASection cta={messages.cta} primaryHref={contactHref} />

  <FaqSection faq={messages.faq} />
</main>

<Footer
  currentLocale={locale}
  navigation={messages.navigation}
  footer={messages.footer}
/>
