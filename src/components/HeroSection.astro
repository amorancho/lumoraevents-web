---
interface Props {
  hero: {
    eyebrow: string;
    title: string;
    description: string;
    primaryCta: string;
    secondaryCta: string;
    highlights: string[];
    panel: {
      label: string;
      title: string;
      description: string;
      note: string;
      items: Array<{
        name: string;
        value: string;
      }>;
    };
  };
  primaryHref: string;
  secondaryHref: string;
}

const { hero, primaryHref, secondaryHref } = Astro.props;
---

<section
  id="product"
  class="shell grid gap-10 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-14 lg:py-24"
>
  <div>
    <span class="eyebrow">{hero.eyebrow}</span>

    <h1
      class="mt-6 max-w-4xl text-5xl font-semibold tracking-tight text-balance sm:text-6xl"
    >
      {hero.title}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-soft">
      {hero.description}
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={primaryHref} class="button-primary">
        {hero.primaryCta}
      </a>
      <a href={secondaryHref} class="button-secondary">
        {hero.secondaryCta}
      </a>
    </div>

    <ul class="mt-10 grid gap-3 text-sm text-ink-soft sm:grid-cols-3">
      {
        hero.highlights.map((item) => (
          <li class="rounded-3xl border border-border/80 bg-white/60 px-4 py-5 leading-6">
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="panel p-8 sm:p-10">
    <div class="flex items-center justify-between gap-4">
      <span
        class="text-xs font-semibold uppercase tracking-[0.22em] text-ink-soft"
      >
        {hero.panel.label}
      </span>
      <span
        class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent"
      >
        Static ready
      </span>
    </div>

    <h2 class="mt-6 text-2xl font-semibold text-balance">
      {hero.panel.title}
    </h2>

    <p class="mt-3 text-sm leading-7 text-ink-soft">
      {hero.panel.description}
    </p>

    <div class="mt-8 space-y-4">
      {
        hero.panel.items.map((item) => (
          <div class="flex items-center justify-between rounded-3xl border border-border/80 bg-surface-muted px-5 py-4">
            <span class="text-sm font-medium text-ink">{item.name}</span>
            <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
              {item.value}
            </span>
          </div>
        ))
      }
    </div>

    <div class="mt-8 rounded-3xl border border-border/80 bg-surface px-5 py-5">
      <p class="text-sm leading-7 text-ink-soft">
        {hero.panel.note}
      </p>
    </div>
  </div>
</section>
