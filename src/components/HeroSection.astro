---
interface Props {
  hero: {
    eyebrow: string;
    title: string;
    description: string;
    primaryCta: string;
    secondaryCta: string;
    imageAlt?: string;
    imageSrc?: string;
    panelLabel: string;
    overlayLabel: string;
    overlayDescription: string;
    placeholderTitle: string;
    placeholderDescription: string;
  };
  primaryHref: string;
  secondaryHref: string;
}

const { hero, primaryHref, secondaryHref } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const logoSrc = `${baseUrl}/images/logo.svg`;
const heroImageSrc = hero.imageSrc?.trim();
const heroImageAlt = hero.imageAlt ?? hero.placeholderTitle;
---

<section
  id="product"
  class="shell relative pb-18 pt-8 sm:pb-24 sm:pt-12 lg:pb-28"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-4 h-64 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.18),transparent_60%)] blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute right-[12%] top-28 h-36 w-36 bg-[radial-gradient(circle,rgba(6,182,212,0.1),transparent_72%)] blur-3xl"
  >
  </div>

  <div class="relative z-10 max-w-[47rem] lg:max-w-[50rem]">
    <span class="eyebrow reveal">{hero.eyebrow}</span>

    <h1
      class="reveal mt-5 max-w-[11ch] whitespace-pre-line text-5xl font-semibold tracking-[-0.08em] text-white sm:text-6xl lg:text-[6.2rem] lg:leading-[0.92]"
      style="--reveal-delay: 80ms"
    >
      {hero.title}
    </h1>

    <p
      class="reveal mt-5 max-w-[36rem] text-lg leading-8 text-copy-soft sm:text-xl"
      style="--reveal-delay: 160ms"
    >
      {hero.description}
    </p>

    <div
      class="reveal mt-7 flex flex-col gap-3 sm:flex-row"
      style="--reveal-delay: 240ms"
    >
      <a href={primaryHref} class="button-primary px-6 py-3.5">
        {hero.primaryCta}
      </a>
      <a
        href={secondaryHref}
        target="_blank"
        rel="noreferrer"
        class="button-secondary px-6 py-3.5"
      >
        {hero.secondaryCta}
      </a>
    </div>
  </div>

  <div class="relative z-10 mt-10 sm:mt-12 lg:mt-10">
    <div
      class="pointer-events-none absolute inset-x-[6%] top-2 hidden h-28 rounded-full bg-[radial-gradient(circle,rgba(124,58,237,0.18),transparent_72%)] blur-3xl sm:block"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-[8%] top-6 bottom-6 hidden rotate-[1.2deg] rounded-[2.8rem] border border-white/6 bg-white/[0.02] lg:block"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-[12%] top-0 h-36 bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.08),transparent_70%)] blur-3xl"
    >
    </div>

    <div class="reveal relative mx-auto max-w-[72rem]" style="--reveal-delay: 320ms">
      <div
        class="pointer-events-none absolute inset-x-[6%] -top-4 bottom-4 hidden rotate-[1.4deg] rounded-[3rem] border border-white/7 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.015))] lg:block"
      >
      </div>

      <div
        class="pointer-events-none absolute -left-3 top-14 hidden h-32 w-32 rounded-full bg-[radial-gradient(circle,rgba(124,58,237,0.16),transparent_68%)] blur-3xl lg:block"
      >
      </div>

      <div
        class="relative overflow-hidden rounded-[2.8rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02))] p-4 shadow-[0_34px_90px_rgba(0,0,0,0.4)] sm:p-5 lg:p-6"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.12),transparent_36%),radial-gradient(circle_at_82%_18%,rgba(6,182,212,0.08),transparent_22%)]"
        >
        </div>

        <div class="relative flex items-center gap-2 border-b border-white/10 pb-4">
          <span class="size-2 rounded-full bg-white/25"></span>
          <span class="size-2 rounded-full bg-white/20"></span>
          <span class="size-2 rounded-full bg-white/15"></span>
          <span
            class="ml-auto hidden rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[0.64rem] font-semibold uppercase tracking-[0.22em] text-copy-soft sm:inline-flex"
          >
            {hero.panelLabel}
          </span>
        </div>

        <div
          class="relative mt-4 overflow-hidden rounded-[2rem] border border-white/10 bg-black/44 p-3 sm:rounded-[2.1rem] sm:p-4"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.14),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.03),transparent_26%,rgba(255,255,255,0.02)_100%)]"
          >
          </div>
          <div
            class="pointer-events-none absolute -inset-x-8 bottom-0 h-28 bg-[radial-gradient(circle_at_bottom,rgba(6,182,212,0.1),transparent_55%)] blur-3xl"
          >
          </div>

          {
            heroImageSrc ? (
              <div class="relative overflow-hidden rounded-[1.5rem] border border-white/8 bg-black/30">
                <img
                  src={heroImageSrc}
                  alt={heroImageAlt}
                  class="h-auto w-full rounded-[1.5rem] object-cover shadow-[0_20px_44px_rgba(0,0,0,0.34)] [transform:perspective(2200px)_rotateX(2deg)_scale(1.01)]"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="relative min-h-[18rem] rounded-[1.5rem] border border-white/8 bg-[linear-gradient(180deg,rgba(20,20,24,0.92),rgba(8,8,9,0.98))] sm:min-h-[24rem] lg:min-h-[30rem]">
                <div
                  class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.14),transparent_42%),radial-gradient(circle_at_80%_18%,rgba(6,182,212,0.08),transparent_24%)]"
                >
                </div>
                <div
                  class="pointer-events-none absolute inset-y-0 left-[11%] hidden w-px bg-white/6 lg:block"
                >
                </div>
                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-[linear-gradient(180deg,transparent,rgba(5,5,6,0.82))]"
                >
                </div>

                <div class="relative flex h-full flex-col justify-between">
                  <div class="flex items-center justify-between px-5 py-5 sm:px-7">
                    <img
                      src={logoSrc}
                      alt="LumoraEvents"
                      class="h-7 w-auto opacity-95 drop-shadow-[0_8px_20px_rgba(0,0,0,0.24)]"
                      loading="lazy"
                    />
                    <span
                      class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[0.64rem] font-semibold uppercase tracking-[0.22em] text-copy-soft sm:hidden"
                    >
                      {hero.panelLabel}
                    </span>
                  </div>

                  <div class="max-w-lg px-5 pb-6 sm:px-7 sm:pb-8 lg:px-8 lg:pb-10">
                    <p
                      class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-copy-soft/70"
                    >
                      {hero.overlayLabel}
                    </p>
                    <p
                      class="mt-4 text-2xl font-semibold tracking-[-0.05em] text-white sm:text-3xl"
                    >
                      {hero.placeholderTitle}
                    </p>
                    <p
                      class="mt-3 max-w-md text-sm leading-7 text-copy-soft sm:text-base"
                    >
                      {hero.placeholderDescription}
                    </p>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <div
        class="absolute right-3 top-[-1.1rem] z-20 hidden w-[12rem] rounded-[1.4rem] border border-white/10 bg-black/52 px-4 py-3 shadow-[0_20px_42px_rgba(0,0,0,0.34)] backdrop-blur-xl sm:block lg:right-8 lg:top-[-1.4rem] lg:w-[13.5rem]"
      >
        <span
          class="inline-flex items-center gap-2 text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-copy-soft/80"
        >
          <span
            class="size-2 rounded-full bg-accent-cyan shadow-[0_0_14px_rgba(6,182,212,0.55)]"
          >
          </span>
          {hero.overlayLabel}
        </span>
        <p class="mt-3 text-sm leading-6 text-white/92">
          {hero.overlayDescription}
        </p>
      </div>
    </div>
  </div>
</section>
