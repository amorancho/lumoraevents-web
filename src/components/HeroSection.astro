---
interface Props {
  hero: {
    title: string;
    description: string;
    keywords?: string[];
  };
}

const { hero } = Astro.props;

const keywords = hero.keywords ?? [];
---

<section
  id="product"
  class="shell pb-7 pt-10 sm:pb-9 sm:pt-14 lg:pb-10 lg:pt-18"
>
  <div class="relative mx-auto max-w-[54rem] text-center">
    <h1
      class="reveal mx-auto max-w-[13ch] whitespace-pre-line text-5xl font-semibold tracking-[-0.08em] text-balance text-white sm:text-6xl lg:text-[5.8rem] lg:leading-[0.92]"
      style="--reveal-delay: 60ms"
    >
      {hero.title}
    </h1>

    <p
      class="reveal mx-auto mt-6 max-w-[40rem] text-lg leading-8 text-copy-soft sm:text-xl"
      style="--reveal-delay: 140ms"
    >
      {hero.description}
    </p>

    {
      keywords.length > 0 && (
        <div class="reveal mt-10 sm:mt-11" style="--reveal-delay: 220ms">
          <ul
            class="flex flex-col items-center justify-center gap-y-3 text-center sm:flex-row sm:flex-wrap sm:gap-x-7 sm:gap-y-4"
          >
          {
            keywords.flatMap((item, index) => [
              index !== 0 && (
                <li aria-hidden="true" class="flex items-center justify-center">
                  <span class="text-[0.84rem] font-semibold uppercase tracking-[0.36em] text-copy/70 sm:hidden">
                    * * *
                  </span>
                  <div class="hidden items-center gap-1.5 sm:flex sm:gap-2">
                    <span class="size-1 rounded-full bg-white/18"></span>
                    <span class="size-1.5 rounded-full bg-accent-cyan/70 shadow-[0_0_10px_rgba(6,182,212,0.22)]"></span>
                    <span class="size-1 rounded-full bg-accent/60 shadow-[0_0_10px_rgba(124,58,237,0.18)]"></span>
                  </div>
                </li>
              ),
              <li class="text-center">
                <span class="block text-[0.84rem] font-semibold uppercase tracking-[0.36em] text-copy/94 sm:text-[0.95rem]">
                  {item}
                </span>
              </li>,
            ])
          }
          </ul>
        </div>
      )
    }
  </div>
</section>
