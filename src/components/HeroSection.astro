---
interface Props {
  hero: {
    eyebrow: string;
    title: string;
    description: string;
  };
}

const { hero } = Astro.props;
---

<section
  id="product"
  class="shell pb-8 pt-8 sm:pb-10 sm:pt-12 lg:pb-12 lg:pt-16"
>
  <div class="max-w-[43rem] lg:max-w-[46rem]">
    <span class="eyebrow reveal">{hero.eyebrow}</span>

    <h1
      class="reveal mt-5 max-w-[11ch] whitespace-pre-line text-5xl font-semibold tracking-[-0.08em] text-white sm:text-6xl lg:text-[5.4rem] lg:leading-[0.94]"
      style="--reveal-delay: 80ms"
    >
      {hero.title}
    </h1>

    <p
      class="reveal mt-5 max-w-[34rem] text-lg leading-8 text-copy-soft sm:text-xl"
      style="--reveal-delay: 160ms"
    >
      {hero.description}
    </p>
  </div>
</section>
