---
import { Buffer } from "node:buffer";

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const analyticsConfig = measurementId
  ? {
      measurementIdBase64: Buffer.from(measurementId).toString("base64"),
    }
  : undefined;
---

{
  analyticsConfig && (
    <script
      is:inline
      id="lumora-analytics-config"
      type="application/json"
      set:html={JSON.stringify(analyticsConfig)}
    />
  )
}
