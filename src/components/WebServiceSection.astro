---
type Benefit = {
  title: string;
  description: string;
};

type Preview = {
  ariaLabel: string;
  brand: string;
  navigation: string[];
  eyebrow: string;
  title: string;
  date: string;
  primaryAction: string;
  secondaryAction: string;
  scheduleLabel: string;
  scheduleItems: string[];
};

interface Props {
  webService: {
    eyebrow: string;
    title: string;
    description: string;
    benefits: Benefit[];
    secondaryText: string;
    preview: Preview;
  };
}

const { webService } = Astro.props;
const benefits = webService.benefits ?? [];
const preview = webService.preview;
---

<section
  id="web-service"
  class="shell relative scroll-mt-28 pb-14 sm:pb-16 lg:pb-20"
>
  <div
    class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(145deg,rgba(16,12,26,0.98),rgba(9,12,18,0.96)_52%,rgba(7,22,27,0.92))] px-6 py-8 shadow-[0_24px_64px_rgba(0,0,0,0.3)] sm:px-8 sm:py-10 lg:px-10 lg:py-12"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_13%_8%,rgba(124,58,237,0.16),transparent_31%),radial-gradient(circle_at_90%_18%,rgba(6,182,212,0.13),transparent_30%)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
    >
    </div>

    <div
      class="relative z-10 grid gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(22rem,0.92fr)] lg:items-center lg:gap-12"
    >
      <div class="max-w-[38rem]">
        <span class="eyebrow reveal">{webService.eyebrow}</span>

        <h2
          class="section-title reveal max-w-[13ch]"
          style="--reveal-delay: 80ms"
        >
          {webService.title}
        </h2>

        <p
          class="section-description reveal max-w-[37rem] text-base sm:text-lg"
          style="--reveal-delay: 140ms"
        >
          {webService.description}
        </p>

        <div class="mt-8 border-t border-white/10 sm:mt-9">
          {
            benefits.map((benefit, index) => (
              <article
                class="reveal grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-b border-white/10 py-5 sm:grid-cols-[2.25rem_minmax(0,1fr)] sm:gap-4"
                style={`--reveal-delay: ${200 + index * 60}ms`}
              >
                <div
                  class="flex flex-col items-center pt-0.5"
                  aria-hidden="true"
                >
                  <span class="flex size-8 items-center justify-center rounded-full border border-white/12 bg-white/[0.045] text-[0.62rem] font-semibold tracking-[0.12em] text-cyan-100/90 sm:size-9">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                <div>
                  <h3 class="text-base font-semibold tracking-[-0.025em] text-white sm:text-lg">
                    {benefit.title}
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-copy-soft">
                    {benefit.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <p
          class="reveal mt-5 flex items-start gap-2.5 text-xs leading-6 text-copy-soft/66 sm:text-sm"
          style="--reveal-delay: 400ms"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
            class="mt-1 size-4 shrink-0 text-copy-soft/55"
          >
            <path
              d="M10 2.75a7.25 7.25 0 1 0 0 14.5 7.25 7.25 0 0 0 0-14.5Z"
              stroke="currentColor"
              stroke-width="1.25"></path>
            <path
              d="M10 8v4.5M10 5.75v.5"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.4"></path>
          </svg>
          <span>{webService.secondaryText}</span>
        </p>
      </div>

      <div
        class="reveal relative mx-auto w-full max-w-[34rem] lg:mx-0 lg:max-w-none"
        style="--reveal-delay: 220ms"
      >
        <div
          class="pointer-events-none absolute -inset-8 bg-[radial-gradient(circle,rgba(6,182,212,0.13),transparent_67%)] blur-2xl"
        >
        </div>

        <div
          class="relative rotate-[0.7deg] overflow-hidden rounded-[1.65rem] border border-white/14 bg-[#090a0d] p-2.5 shadow-[0_34px_80px_rgba(0,0,0,0.5),0_0_0_1px_rgba(255,255,255,0.025)] sm:p-3"
          role="img"
          aria-label={preview.ariaLabel}
        >
          <div
            class="flex items-center gap-1.5 px-2 pb-2.5 pt-0.5"
            aria-hidden="true"
          >
            <span class="size-2 rounded-full bg-white/18"></span>
            <span class="size-2 rounded-full bg-white/12"></span>
            <span class="size-2 rounded-full bg-white/8"></span>
            <span
              class="ml-2 h-5 flex-1 rounded-full border border-white/8 bg-white/[0.035]"
            ></span>
          </div>

          <div
            class="overflow-hidden rounded-[1.2rem] border border-white/10 bg-[#0d1015]"
          >
            <header
              class="flex items-center justify-between gap-4 border-b border-white/8 px-4 py-3 sm:px-5"
            >
              <div class="flex items-center gap-2.5">
                <span
                  class="flex size-7 items-center justify-center rounded-lg border border-cyan-200/16 bg-cyan-300/10"
                >
                  <span
                    class="size-2 rounded-full bg-cyan-300 shadow-[0_0_12px_rgba(34,211,238,0.75)]"
                  ></span>
                </span>
                <span
                  class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-white/88"
                >
                  {preview.brand}
                </span>
              </div>

              <nav class="hidden items-center gap-4 sm:flex" aria-hidden="true">
                {
                  preview.navigation.map((item) => (
                    <span class="text-[0.55rem] font-medium text-copy-soft/70">
                      {item}
                    </span>
                  ))
                }
              </nav>

              <span class="flex flex-col gap-1 sm:hidden" aria-hidden="true">
                <span class="h-px w-4 bg-white/60"></span>
                <span class="h-px w-4 bg-white/60"></span>
              </span>
            </header>

            <div
              class="relative overflow-hidden px-5 pb-7 pt-8 sm:px-7 sm:pb-9 sm:pt-10"
            >
              <div
                class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_82%_18%,rgba(6,182,212,0.2),transparent_28%),radial-gradient(circle_at_12%_80%,rgba(124,58,237,0.2),transparent_34%)]"
              >
              </div>
              <div
                class="pointer-events-none absolute right-[-2rem] top-5 size-36 rounded-full border border-cyan-200/10"
              >
              </div>
              <div
                class="pointer-events-none absolute right-3 top-12 size-24 rounded-full border border-white/8"
              >
              </div>

              <div class="relative z-10 max-w-[18rem]">
                <div class="flex items-center gap-2">
                  <span class="size-1.5 rounded-full bg-accent-cyan"></span>
                  <span
                    class="text-[0.52rem] font-semibold uppercase tracking-[0.24em] text-cyan-100/78"
                  >
                    {preview.eyebrow}
                  </span>
                </div>

                <p
                  class="mt-3 text-[1.65rem] font-semibold leading-[1.02] tracking-[-0.06em] text-white sm:text-[2rem]"
                >
                  {preview.title}
                </p>
                <p class="mt-3 text-[0.65rem] text-copy-soft/76">
                  {preview.date}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                  <span
                    class="rounded-full border border-violet-200/16 bg-violet-500/70 px-3 py-1.5 text-[0.55rem] font-semibold text-white shadow-[0_8px_18px_rgba(109,40,217,0.22)]"
                  >
                    {preview.primaryAction}
                  </span>
                  <span
                    class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[0.55rem] font-semibold text-white/82"
                  >
                    {preview.secondaryAction}
                  </span>
                </div>
              </div>
            </div>

            <div
              class="border-t border-white/8 bg-white/[0.018] px-4 py-4 sm:px-5"
            >
              <div class="flex items-center justify-between gap-3">
                <span
                  class="text-[0.52rem] font-semibold uppercase tracking-[0.2em] text-copy-soft/58"
                >
                  {preview.scheduleLabel}
                </span>
                <span
                  class="h-px flex-1 bg-gradient-to-r from-white/12 to-transparent"
                ></span>
              </div>

              <div class="mt-3 grid grid-cols-3 gap-2">
                {
                  preview.scheduleItems.map((item, index) => (
                    <div class="rounded-[0.8rem] border border-white/8 bg-black/24 p-2.5">
                      <span
                        class:list={[
                          "block size-1.5 rounded-full",
                          index === 1 ? "bg-accent/80" : "bg-accent-cyan/75",
                        ]}
                      />
                      <p class="mt-2 text-[0.52rem] font-medium leading-4 text-copy-soft/78">
                        {item}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div
          class="absolute -bottom-4 -left-3 hidden items-center gap-2 rounded-full border border-white/12 bg-[#101116]/94 px-3 py-2 shadow-[0_14px_30px_rgba(0,0,0,0.34)] backdrop-blur-sm sm:flex"
          aria-hidden="true"
        >
          <span
            class="size-1.5 rounded-full bg-emerald-300 shadow-[0_0_8px_rgba(110,231,183,0.55)]"
          ></span>
          <span
            class="text-[0.55rem] font-semibold uppercase tracking-[0.18em] text-copy-soft/78"
          >
            Responsive
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
