---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocalizedPath } from "../utils/i18n";
import { siteConfig, type Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  navigation: {
    links: Array<{
      label: string;
      href: string;
    }>;
  };
  footer: {
    tagline: string;
    contactLabel: string;
  };
}

const { currentLocale, navigation, footer } = Astro.props;
const homePath = getLocalizedPath(currentLocale);
const year = new Date().getFullYear();
---

<footer class="border-t border-black/5 py-10">
  <div class="shell flex flex-col gap-8">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ink">
          LumoraEvents
        </p>
        <p class="mt-2 max-w-xl text-sm leading-7 text-ink-soft">
          {footer.tagline}
        </p>
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <LanguageSwitcher currentLocale={currentLocale} />
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-sm font-medium text-ink-soft hover:text-ink"
        >
          {footer.contactLabel}
        </a>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 border-t border-border pt-6 text-sm text-ink-soft md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} LumoraEvents. All rights reserved.</p>

      <nav class="flex flex-wrap gap-5">
        {
          navigation.links.map((link) => (
            <a href={`${homePath}${link.href}`} class="hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
