---
import { getLocalizedPath } from "../utils/i18n";
import { siteConfig, type Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  navigation: {
    links: Array<{
      label: string;
      href: string;
    }>;
  };
  footer: {
    tagline: string;
  };
}

const { currentLocale, navigation, footer } = Astro.props;
const homePath = getLocalizedPath(currentLocale);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const logoSrc = `${baseUrl}/images/logo.svg`;
const year = new Date().getFullYear();
---

<footer class="py-12 sm:py-14">
  <div class="shell border-t border-white/8 pt-8 sm:pt-10">
    <div class="flex flex-col gap-10">
      <div
        class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-[31rem]">
          <a
            href={homePath}
            aria-label="LumoraEvents home"
            class="inline-flex items-center"
          >
            <img
              src={logoSrc}
              alt="LumoraEvents"
              class="h-8 w-auto drop-shadow-[0_8px_18px_rgba(0,0,0,0.24)] sm:h-9"
              loading="lazy"
            />
          </a>
          <p class="mt-5 max-w-[26rem] text-sm leading-7 text-copy-soft">
            {footer.tagline}
          </p>
        </div>

        <div class="flex flex-col items-start gap-3 sm:items-end">
          <a
            href={siteConfig.instagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="LumoraEvents Instagram"
            class="group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-copy shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] transition-[transform,border-color,background-color,color] duration-300 hover:-translate-y-0.5 hover:border-white/16 hover:bg-white/[0.05]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="size-4 text-copy-soft transition-colors duration-300 group-hover:text-copy"
            >
              <rect
                x="3.75"
                y="3.75"
                width="16.5"
                height="16.5"
                rx="4.25"
                stroke="currentColor"
                stroke-width="1.4"
              ></rect>
              <circle
                cx="12"
                cy="12"
                r="3.7"
                stroke="currentColor"
                stroke-width="1.4"
              ></circle>
              <circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"></circle>
            </svg>
            <span>{siteConfig.instagramHandle}</span>
          </a>

          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex items-center gap-2 text-sm text-copy-soft transition-colors duration-300 hover:text-copy sm:justify-end"
          >
            <span class="size-1 rounded-full bg-white/18"></span>
            <span>{siteConfig.email}</span>
          </a>
        </div>
      </div>

      <div
        class="flex flex-col gap-4 border-t border-white/8 pt-6 text-sm text-copy-soft md:flex-row md:items-center md:justify-between"
      >
        <nav class="flex flex-wrap gap-5">
          {
            navigation.links.map((link) => (
              <a
                href={`${homePath}${link.href}`}
                class="transition-colors duration-300 hover:text-copy"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <p>Copyright {year} LumoraEvents. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
