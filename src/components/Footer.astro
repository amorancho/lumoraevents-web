---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocalizedPath } from "../utils/i18n";
import { siteConfig, type Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  navigation: {
    links: Array<{
      label: string;
      href: string;
    }>;
  };
  footer: {
    tagline: string;
    contactLabel: string;
  };
}

const { currentLocale, navigation, footer } = Astro.props;
const homePath = getLocalizedPath(currentLocale);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const logoSrc = `${baseUrl}/images/logo.svg`;
const year = new Date().getFullYear();
---

<footer class="py-12 sm:py-14">
  <div class="shell border-t border-white/8 pt-8 sm:pt-10">
    <div class="flex flex-col gap-10">
      <div
        class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-[32rem]">
          <a
            href={homePath}
            aria-label="LumoraEvents home"
            class="inline-flex items-center"
          >
            <img
              src={logoSrc}
              alt="LumoraEvents"
              class="h-8 w-auto drop-shadow-[0_8px_18px_rgba(0,0,0,0.24)] sm:h-9"
              loading="lazy"
            />
          </a>
          <p class="mt-5 max-w-xl text-sm leading-7 text-copy-soft">
            {footer.tagline}
          </p>
        </div>

        <div class="flex flex-col items-start gap-4 sm:items-end">
          <div
            class="flex flex-wrap items-center gap-3 text-sm text-copy-soft sm:justify-end"
          >
            <a
              href={`mailto:${siteConfig.email}`}
              class="font-medium hover:text-copy"
            >
              {footer.contactLabel}
            </a>
            <span class="size-1 rounded-full bg-white/16"></span>
            <a
              href={siteConfig.instagramUrl}
              target="_blank"
              rel="noreferrer"
              class="font-medium hover:text-copy"
            >
              {siteConfig.instagramHandle}
            </a>
          </div>

          <LanguageSwitcher currentLocale={currentLocale} />
        </div>
      </div>

      <div
        class="flex flex-col gap-4 border-t border-white/8 pt-6 text-sm text-copy-soft md:flex-row md:items-center md:justify-between"
      >
        <nav class="flex flex-wrap gap-5">
          {
            navigation.links.map((link) => (
              <a href={`${homePath}${link.href}`} class="hover:text-copy">
                {link.label}
              </a>
            ))
          }
        </nav>

        <p>Copyright {year} LumoraEvents. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
