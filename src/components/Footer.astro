---
import packageInfo from "../../package.json";
import { getPagePath, type SitePage } from "../utils/routes";
import { siteConfig, type Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  navigation: {
    footerLinks: ReadonlyArray<{
      label: string;
      page: string;
    }>;
    appLabel: string;
    homeAriaLabel: string;
    logoAlt: string;
  };
  footer: {
    tagline: string;
    accessLabel: string;
    instagramLabel: string;
    instagramAriaLabel: string;
    cookieSettingsLabel: string;
    copyright: string;
    versionDisplay: string;
    versionAriaLabel: string;
  };
}

const { currentLocale, navigation, footer } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const getHref = (page: string) =>
  `${baseUrl}${getPagePath(currentLocale, page as SitePage)}`;
const logoSrc = `${baseUrl}${siteConfig.brandLogo}`;
const appVersion = footer.versionDisplay.replace("{version}", packageInfo.version);
const year = new Date().getFullYear();
const copyrightLabel = footer.copyright.replace("{year}", String(year));
const versionAriaLabel = footer.versionAriaLabel.replace(
  "{version}",
  packageInfo.version,
);
const primaryFooterLinks = navigation.footerLinks.filter(
  (link) => link.page === "about" || link.page === "contact",
);
const secondaryFooterLinks = navigation.footerLinks.filter(
  (link) => link.page !== "about" && link.page !== "contact",
);
---

<footer class="py-10 sm:py-12">
  <div class="shell border-t border-white/8 pt-8 sm:pt-9">
    <div class="flex flex-col gap-8">
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(13rem,0.72fr)_minmax(13rem,0.88fr)] lg:items-start"
      >
        <div class="max-w-[34rem]">
          <a
            href={getHref("home")}
            aria-label={navigation.homeAriaLabel}
            class="inline-flex items-center"
          >
            <img
              src={logoSrc}
              alt={navigation.logoAlt}
              class="h-8 w-auto sm:h-9"
              loading="lazy"
            />
          </a>
          <p class="mt-5 max-w-[31rem] text-sm leading-7 text-copy-soft">
            {footer.tagline}
          </p>
        </div>

        <div class="flex flex-col gap-3 lg:pt-1">
          <nav class="flex flex-col items-start gap-2">
            {
              primaryFooterLinks.map((link) => (
                <a
                  href={getHref(link.page)}
                  class="group inline-flex min-w-[9rem] items-center justify-between gap-3 rounded-full border border-white/8 bg-white/[0.015] px-3.5 py-2 text-[0.78rem] font-medium text-copy-soft shadow-[inset_0_1px_0_rgba(255,255,255,0.035)] transition-[border-color,background-color,color] duration-200 hover:border-white/12 hover:bg-white/[0.03] hover:text-copy"
                >
                  <span class="flex items-center gap-3">
                    <span class="size-1.5 rounded-full bg-accent-cyan/55 transition-colors duration-200 group-hover:bg-accent-cyan/80"></span>
                    <span>{link.label}</span>
                  </span>
                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                    class="size-3.5 text-copy-soft/70 transition-[transform,color] duration-200 group-hover:translate-x-0.5 group-hover:text-copy"
                  >
                    <path
                      d="M7 5.5 11.5 10 7 14.5M11.5 10H4.5"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                    ></path>
                  </svg>
                </a>
              ))
            }
          </nav>
        </div>

        <div class="flex flex-col items-start gap-3 lg:items-end lg:pt-1">
          <a
            href={siteConfig.instagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label={footer.instagramAriaLabel}
            class="group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-copy shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] transition-[border-color,background-color,color] duration-200 hover:border-white/16 hover:bg-white/[0.05]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="size-4 text-copy-soft transition-colors duration-300 group-hover:text-copy"
            >
              <rect
                x="3.75"
                y="3.75"
                width="16.5"
                height="16.5"
                rx="4.25"
                stroke="currentColor"
                stroke-width="1.4"
              ></rect>
              <circle
                cx="12"
                cy="12"
                r="3.7"
                stroke="currentColor"
                stroke-width="1.4"
              ></circle>
              <circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"></circle>
            </svg>
            <span>{footer.instagramLabel}</span>
          </a>

          <a
            href={siteConfig.appUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-copy shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] transition-[border-color,background-color,color] duration-200 hover:border-white/16 hover:bg-white/[0.05] sm:justify-end"
          >
            <span class="size-1.5 rounded-full bg-accent-cyan/80"></span>
            <span>{footer.accessLabel}</span>
          </a>
        </div>
      </div>

      <div
        class="flex flex-col gap-4 border-t border-white/8 pt-6 text-sm text-copy-soft lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-5">
          <nav class="flex flex-wrap gap-5">
            {
              secondaryFooterLinks.map((link) => (
                <a
                  href={getHref(link.page)}
                  class="transition-colors duration-300 hover:text-copy"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>

          <button
            type="button"
            data-open-cookie-settings
            class="inline-flex items-center text-left transition-colors duration-300 hover:text-copy"
          >
            {footer.cookieSettingsLabel}
          </button>
        </div>

        <p>
          {copyrightLabel}
          <span class="text-copy-soft/70" aria-label={versionAriaLabel}>
            ({appVersion})
          </span>
        </p>
      </div>
    </div>
  </div>
</footer>
