---
import { getLocalizedPath, localeEntries } from "../utils/i18n";
import type { Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  slug?: string;
}

const { currentLocale, slug = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div
  class="inline-flex items-center rounded-full border border-border bg-surface p-1"
>
  {
    localeEntries.map(({ code, label }) => (
      <a
        href={`${baseUrl}${getLocalizedPath(code, slug)}`}
        hreflang={code}
        aria-current={code === currentLocale ? "page" : undefined}
        class:list={[
          "rounded-full px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em]",
          code === currentLocale
            ? "bg-ink text-white"
            : "text-ink-soft hover:text-ink",
        ]}
      >
        <span class="sr-only">{label}</span>
        {code}
      </a>
    ))
  }
</div>
