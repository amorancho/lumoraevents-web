---
import { getLocalizedPath, getMessages, localeEntries } from "../utils/i18n";
import { getPagePath, type SitePage } from "../utils/routes";
import type { Locale } from "../utils/site";

interface Props {
  currentLocale: Locale;
  currentPage?: SitePage;
  slug?: string;
}

const { currentLocale, currentPage, slug = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const localeSwitcher = getMessages(currentLocale).navigation.localeSwitcher;
const getHref = (locale: Locale) =>
  `${baseUrl}${
    currentPage ? getPagePath(locale, currentPage) : getLocalizedPath(locale, slug)
  }`;
---

<div
  class="inline-flex items-center rounded-full border border-white/10 bg-black/25 p-1"
>
  {
    localeEntries.map(({ code }) => {
      const localeOption = localeSwitcher.locales[code];

      return (
        <a
          href={getHref(code)}
          hreflang={code}
          aria-current={code === currentLocale ? "page" : undefined}
          class:list={[
            "rounded-full px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.22em]",
            code === currentLocale
              ? "border border-white/12 bg-white/[0.08] text-copy shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]"
              : "text-copy-soft hover:text-copy",
          ]}
        >
          <span class="sr-only">{localeOption.label}</span>
          {localeOption.shortLabel}
        </a>
      );
    })
  }
</div>
