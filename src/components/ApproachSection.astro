---
type ApproachItem = {
  title: string;
  description: string;
};

type ApproachAccent = {
  variant: "linked" | "offset" | "step" | "orbit";
  dot: string;
  glow: string;
};

interface Props {
  approach: {
    eyebrow: string;
    title: string;
    description: string;
    items: ApproachItem[];
  };
}

const { approach } = Astro.props;
const items = approach.items ?? [];

const pillarAccents: ApproachAccent[] = [
  {
    variant: "linked",
    dot: "#06b6d4",
    glow: "rgba(6,182,212,0.18)",
  },
  {
    variant: "offset",
    dot: "#7c3aed",
    glow: "rgba(124,58,237,0.18)",
  },
  {
    variant: "step",
    dot: "#06b6d4",
    glow: "rgba(6,182,212,0.16)",
  },
  {
    variant: "orbit",
    dot: "#7c3aed",
    glow: "rgba(124,58,237,0.16)",
  },
];
---

<section class="shell relative py-16 sm:py-20 lg:py-24">
  <div class="surface-card relative overflow-hidden px-6 py-8 sm:px-8 sm:py-9 lg:px-10 lg:py-10">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.08),transparent_34%),radial-gradient(circle_at_82%_18%,rgba(6,182,212,0.08),transparent_24%)]"
    >
    </div>

    <div class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-10">
      <div class="max-w-[33rem]">
        <span class="eyebrow reveal">{approach.eyebrow}</span>
        <h2
          class="section-title reveal max-w-[12ch]"
          style="--reveal-delay: 80ms"
        >
          {approach.title}
        </h2>
        <p
          class="section-description reveal max-w-[30rem] text-base sm:text-lg"
          style="--reveal-delay: 160ms"
        >
          {approach.description}
        </p>
      </div>

      <div class="reveal grid gap-4 sm:grid-cols-2" style="--reveal-delay: 220ms">
        {
          items.map((item, index) => {
            const accent = pillarAccents[index] ?? pillarAccents[0];

            return (
              <article class="group rounded-[1.7rem] border border-white/10 bg-black/36 p-5 transition-[border-color,background-color] duration-200 hover:border-white/16 hover:bg-white/[0.03]">
                <div class="flex items-center gap-4">
                  <div class="relative flex h-10 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-white/[0.025] shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] transition-[border-color,background-color] duration-200 group-hover:border-white/16 group-hover:bg-white/[0.04]">
                    <div
                      class="pointer-events-none absolute inset-0 opacity-45 transition-opacity duration-200 group-hover:opacity-70"
                      style={`background: radial-gradient(circle at 50% 50%, ${accent.glow}, transparent 72%);`}
                    >
                    </div>

                    {accent.variant === "linked" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 10h32"
                          stroke="rgba(255,255,255,0.36)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="12" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="24" cy="10" r="2.1" fill={accent.dot}></circle>
                        <circle cx="36" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                      </svg>
                    )}

                    {accent.variant === "offset" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 6.5h12M8 13.5h20M28 6.5h12"
                          stroke="rgba(255,255,255,0.38)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <path
                          d="M24 6.5v7"
                          stroke="rgba(255,255,255,0.32)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="24" cy="13.5" r="2" fill={accent.dot}></circle>
                      </svg>
                    )}

                    {accent.variant === "step" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 12h8M20 8h8M32 12h8"
                          stroke="rgba(255,255,255,0.38)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="18" cy="12" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="30" cy="8" r="2.1" fill={accent.dot}></circle>
                      </svg>
                    )}

                    {accent.variant === "orbit" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M9 10c3.5-3.8 9.5-3.8 13 0M26 10c3.5 3.8 9.5 3.8 13 0"
                          stroke="rgba(255,255,255,0.36)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="11" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="37" cy="10" r="2.1" fill={accent.dot}></circle>
                      </svg>
                    )}
                  </div>

                  <span class="h-px flex-1 bg-gradient-to-r from-white/16 via-white/6 to-transparent transition-opacity duration-200 group-hover:from-white/20 group-hover:via-white/9"></span>
                </div>

                <h3 class="mt-5 max-w-[15ch] text-lg font-semibold tracking-[-0.03em] text-white sm:text-[1.1rem]">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-[24rem] text-sm leading-7 text-copy-soft">
                  {item.description}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
