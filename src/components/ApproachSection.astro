---
type ApproachItem = {
  title: string;
  description: string;
};

type ApproachAccent = {
  variant: "linked" | "offset" | "step" | "orbit";
  dot: string;
  glow: string;
};

interface Props {
  approach: {
    eyebrow: string;
    title: string;
    description: string;
    items: ApproachItem[];
  };
}

const { approach } = Astro.props;

const fallbackItems: ApproachItem[] = [
  {
    title: "One place for the moving parts",
    description:
      "The event's operational core stays connected instead of being pieced together from separate files and messages.",
  },
  {
    title: "Clarity when plans shift",
    description:
      "If timings, categories, or last-minute details change, the structure stays readable.",
  },
  {
    title: "Support that stays close",
    description:
      "We stay available before, during, and after the event so questions do not become extra pressure.",
  },
  {
    title: "Less chaos before the event",
    description:
      "Schedules, participants, music, and changes stop living across spreadsheets, emails, and separate lists.",
  },
];

const items = fallbackItems.map((fallbackItem, index) => ({
  ...fallbackItem,
  ...(approach.items[index] ?? {}),
}));

const pillarAccents: ApproachAccent[] = [
  {
    variant: "linked",
    dot: "#06b6d4",
    glow: "rgba(6,182,212,0.18)",
  },
  {
    variant: "offset",
    dot: "#7c3aed",
    glow: "rgba(124,58,237,0.18)",
  },
  {
    variant: "step",
    dot: "#06b6d4",
    glow: "rgba(6,182,212,0.16)",
  },
  {
    variant: "orbit",
    dot: "#7c3aed",
    glow: "rgba(124,58,237,0.16)",
  },
];
---

<section class="shell relative py-20 sm:py-24 lg:py-28">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-48 bg-[radial-gradient(circle_at_top,rgba(124,58,237,0.1),transparent_68%)] blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute left-[12%] top-28 hidden h-24 w-24 rounded-full bg-[radial-gradient(circle,rgba(6,182,212,0.08),transparent_72%)] blur-3xl lg:block"
  >
  </div>

  <div
    class="relative z-10 grid gap-14 border-y border-white/8 py-12 sm:gap-16 sm:py-14 lg:grid-cols-[minmax(0,0.86fr)_minmax(0,1.14fr)] lg:gap-20 lg:py-16"
  >
    <div class="max-w-[31rem]">
      <span class="eyebrow reveal">{approach.eyebrow}</span>
      <h2
        class="reveal mt-5 max-w-[12ch] text-4xl font-semibold tracking-[-0.06em] text-balance text-white sm:text-5xl lg:text-[3.8rem] lg:leading-[0.98]"
        style="--reveal-delay: 80ms"
      >
        {approach.title}
      </h2>
      <p
        class="reveal mt-6 max-w-[29rem] text-lg leading-8 text-copy-soft sm:text-xl"
        style="--reveal-delay: 160ms"
      >
        {approach.description}
      </p>
    </div>

    <div class="reveal relative" style="--reveal-delay: 220ms">
      <div
        class="pointer-events-none absolute inset-y-2 left-0 hidden w-px bg-white/8 lg:block"
      >
      </div>

      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-2 lg:pl-12 xl:gap-x-10 xl:gap-y-10">
        {
          items.map((item, index) => {
            const accent = pillarAccents[index] ?? pillarAccents[0];

            return (
              <article class="group relative pt-2">
                <div class="flex items-center gap-4">
                  <div class="relative flex h-9 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-white/[0.025] shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] transition-[border-color,background-color,transform] duration-300 group-hover:-translate-y-0.5 group-hover:border-white/16 group-hover:bg-white/[0.045] sm:h-10 sm:w-14">
                    <div
                      class="pointer-events-none absolute inset-0 opacity-55 transition-opacity duration-300 group-hover:opacity-95"
                      style={`background: radial-gradient(circle at 50% 50%, ${accent.glow}, transparent 72%);`}
                    >
                    </div>

                    {accent.variant === "linked" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 10h32"
                          stroke="rgba(255,255,255,0.36)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="12" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="24" cy="10" r="2.1" fill={accent.dot}></circle>
                        <circle cx="36" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                      </svg>
                    )}

                    {accent.variant === "offset" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 6.5h12M8 13.5h20M28 6.5h12"
                          stroke="rgba(255,255,255,0.38)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <path
                          d="M24 6.5v7"
                          stroke="rgba(255,255,255,0.32)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="24" cy="13.5" r="2" fill={accent.dot}></circle>
                      </svg>
                    )}

                    {accent.variant === "step" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M8 12h8M20 8h8M32 12h8"
                          stroke="rgba(255,255,255,0.38)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="18" cy="12" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="30" cy="8" r="2.1" fill={accent.dot}></circle>
                      </svg>
                    )}

                    {accent.variant === "orbit" && (
                      <svg
                        viewBox="0 0 48 20"
                        fill="none"
                        aria-hidden="true"
                        class="relative z-10 h-3.5 w-10"
                      >
                        <path
                          d="M9 10c3.5-3.8 9.5-3.8 13 0M26 10c3.5 3.8 9.5 3.8 13 0"
                          stroke="rgba(255,255,255,0.36)"
                          stroke-linecap="round"
                          stroke-width="1.2"
                        ></path>
                        <circle cx="11" cy="10" r="1.8" fill="rgba(255,255,255,0.42)"></circle>
                        <circle cx="37" cy="10" r="2.1" fill={accent.dot}></circle>
                      </svg>
                    )}
                  </div>

                  <span class="h-px flex-1 bg-gradient-to-r from-white/14 via-white/6 to-transparent transition-opacity duration-300 group-hover:from-white/20 group-hover:via-white/10"></span>
                </div>

                <h3 class="mt-5 max-w-[16rem] text-lg font-semibold tracking-[-0.03em] text-white transition-colors duration-300 group-hover:text-white/95 sm:text-[1.15rem]">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-[25rem] text-sm leading-7 text-copy-soft sm:text-base">
                  {item.description}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
